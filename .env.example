# 复制为 .env 后按需修改。全部可选，说明见 docs/DEPLOY.md。
# .env 不会被提交；API Key 不写在这里，在 App 的设置里填。

# JURVIS_HOST=0.0.0.0
# JURVIS_PORT=18777
# 从公网访问引擎的 https 地址（反向代理或隧道）；留空时自动发现 Tailscale Funnel。
# JURVIS_PUBLIC_URL=
# JURVIS_DATA=data

# 换用别的本机模型：models/ 下的目录名，或绝对路径。见 docs/MODELS.md。
# JURVIS_LOCAL_MODEL=

# 额外读取的技能目录；留空关闭。
# JURVIS_SHARED_SKILLS=~/.claude/skills

# Apple 开发团队 ID，只有 scripts/testflight.sh 用。
# JURVIS_TEAM_ID=

# 健康数据：WHOOP 和 Google Health 各需要一个你自己的 OAuth 应用，见 docs/HEALTH.md。也可以不写在这里，直接在「设置 → 健康与运动」里填。Apple 健康在 iPhone 上读取，不用填。
# JURVIS_WHOOP_CLIENT_ID=
# JURVIS_WHOOP_CLIENT_SECRET=
# JURVIS_GOOGLE_CLIENT_ID=
# JURVIS_GOOGLE_CLIENT_SECRET=
# 连接完成后浏览器回到的地址；留空用 JURVIS_PUBLIC_URL，再没有就用 https://localhost:<端口>。
# JURVIS_OAUTH_BASE=
